# ── SBC-NG ────────────────────────────────────────────────────────────────────
VERSION=0.1.0

# Cómo te ve el mundo. Si tu IP es dinámica, poné el nombre DDNS: el SBC lo
# resuelve al arrancar y un watcher lo vuelve a resolver si cambia.
PUBLIC_IP=
DOMAIN=

# Base propia del SBC
DB_NAME=sbcng
DB_USER=sbcng
DB_PASS=

# Secreto del panel (se genera solo en la instalación)
JWT_SECRET=

# Medios
RTP_PORT_MIN=30000
RTP_PORT_MAX=40000
CODECS=PCMU,PCMA,G722,opus,G729

# TURN (módulo opcional)
TURN_USER=sbcng
TURN_PASS=
