# ── SBC-NG ────────────────────────────────────────────────────────────────────
VERSION=0.1.0

# Cómo te ve el mundo. Si tu IP es dinámica, poné acá el nombre DDNS: Kamailio,
# rtpengine y coturn lo resuelven al arrancar, y el watcher los recicla cuando
# la IP cambia (sin eso, el TURN sigue anunciando la IP vieja y no hay audio).
PUBLIC_IP=
DOMAIN=

# IP del host. Kamailio y rtpengine corren en modo host, así que el control-plane
# (que sí está en la red de docker) los alcanza por acá. El instalador la detecta.
HOST_IP=172.17.0.1

# Red confiable, exenta del anti-flood (por defecto, el /24 del propio servidor).
TRUSTED_NET=

# Base propia del SBC — no comparte nada con ninguna central
DB_NAME=sbcng
DB_USER=sbcng
DB_PASS=

# Secreto del panel (lo genera el instalador)
JWT_SECRET=

# Medios (RTP). Estos puertos hay que abrirlos en el firewall.
RTP_PORT_MIN=30000
RTP_PORT_MAX=40000

# TURN (perfil opcional: docker compose --profile turn)
TURN_USER=sbcng
TURN_PASS=
TURN_PORT_MIN=49152
TURN_PORT_MAX=65535
